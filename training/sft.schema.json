{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYNVORA grounded SFT example",
  "type": "object",
  "required": ["messages", "metadata"],
  "properties": {
    "messages": {"type":"array","minItems":3,"items":{"type":"object","required":["role","content"],"properties":{"role":{"enum":["system","user","tool","assistant"]},"content":{"type":"string"}},"additionalProperties":false}},
    "metadata": {"type":"object","required":["tradition","feature","sources","verified"],"properties":{"tradition":{"type":"string","minLength":1},"feature":{"type":"string","minLength":1},"sources":{"type":"array","items":{"type":"string"},"minItems":1},"verified":{"const":true},"datasetVersion":{"type":"string"}},"additionalProperties":true}
  },
  "additionalProperties":false
}
